<?xml version="1.0"?>

<project basedir="." default="run" name="benchmarks" xmlns:if="ant:if" xmlns:unless="ant:unless">
	<import file="../build-common.xml" />

	<property name="sample-data-sql" value="sample-data-${sample.sql.db.type}.sql" />
	<property name="build-db-file" value="../sql/build.xml" />

	<macrodef name="build-sql">
		<attribute name="dir" />
		<sequential>
			<ant antfile="${build-db-file}" inheritall="false" target="build-db">
				<property name="db.sql.dir" value="@{dir}" />
			</ant>

			<concat append="true" destfile="${sample-data-sql}">
				<filelist dir="@{dir}/tables/" files="tables-${sample.sql.db.type}.sql" />
				<filelist dir="@{dir}/indexes/" files="indexes-${sample.sql.db.type}.sql" />
			</concat>
		</sequential>
	</macrodef>

	<target depends="clean" name="build-sample-sql">
		<gradle-execute dir="../modules/util/portal-tools-sample-sql-builder" task="jar" />

		<path id="sample.sql.builder.classpath">
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.blogs.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.commerce.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.dynamic.data.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.fragment.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.friendly.url.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.journal.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.layout.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.message.boards.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.portal.tools.sample.sql.builder*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.subscription.*.jar"
			/>

			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.view.count.*.jar"
			/>

			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.wiki.*.jar"
			/>
			<path refid="project.classpath" />
		</path>

		<available file="benchmarks.${user.name}.properties" property="user.properites.avaiable" />
		<available file="benchmarks.${env.COMPUTERNAME}.properties" property="env.computer.name.properites.avaiable" />
		<available file="benchmarks.${env.HOST}.properties" property="env.host.properites.avaiable" />
		<available file="benchmarks.${env.HOSTNAME}.properties" property="env.host.name.properites.avaiable" />

		<concat append="true" destfile="benchmarks.merge.properties" fixlastline="true" if:true="${env.host.name.properites.avaiable}">
			<filelist dir="${basedir}" files="benchmarks.${env.HOSTNAME}.properties" />
		</concat>

		<concat append="true" destfile="benchmarks.merge.properties" fixlastline="true" if:true="${env.host.properites.avaiable}">
			<filelist dir="${basedir}" files="benchmarks.${env.HOST}.properties" />
		</concat>

		<concat append="true" destfile="benchmarks.merge.properties" fixlastline="true" if:true="${env.computer.name.properites.avaiable}">
			<filelist dir="${basedir}" files="benchmarks.${env.COMPUTERNAME}.properties" />
		</concat>

		<concat append="true" destfile="benchmarks.merge.properties" fixlastline="true" if:true="${user.properites.avaiable}">
			<filelist dir="${basedir}" files="benchmarks.${user.name}.properties" />
		</concat>

		<if>
			<and>
				<equals arg1="${user.properites.avaiable}" arg2="false" />
				<equals arg1="${env.computer.name.properites.avaiable}" arg2="false" />
				<equals arg1="${env.host.properites.avaiable}" arg2="false" />
				<equals arg1="${env.host.name.properites.avaiable}" arg2="false" />
			</and>
			<then>
				<concat append="false" destfile="benchmarks.customer.properties" file="benchmarks.properties" />
			</then>
			<else>
				<taskdef
					classname="com.liferay.util.ant.MergeCustomerPropertiesTask"
					classpath="${project.dir}/util-java/util-java.jar"
					name="merge-customer-properties"
				/>

				<merge-customer-properties inputPropertiesFile="benchmarks.merge.properties" outputPropertiesFile="benchmarks.customer.properties" rootDir="${basedir}" />
			</else>
		</if>

		<property name="sample.sql.properties.file" value="benchmarks.customer.properties" />

		<java
			classname="com.liferay.portal.tools.sample.sql.builder.SampleSQLBuilder"
			classpathref="sample.sql.builder.classpath"
		>
			<sysproperty key="external-properties" value="com/liferay/portal/tools/dependencies/portal-tools.properties" />
			<sysproperty key="sample-sql-properties" value="${sample.sql.properties.file}" />
		</java>

		<concat append="true" destfile="${sample-data-sql}">
			<filelist dir="../sql/portal/" files="portal-${sample.sql.db.type}.sql" />
			<filelist dir="../sql/indexes/" files="indexes-${sample.sql.db.type}.sql" />
		</concat>

		<for list="${portal.module.dir.list}" param="module">
			<sequential>
				<build-sql dir="@{module}" />
			</sequential>
		</for>

		<if>
			<isfalse value="${benchmark.usage}" />
			<then>
				<if>
					<equals arg1="${sample.sql.output.merge}" arg2="false" />
					<then>
						<for param="sql-file-filename">
							<path>
								<fileset
									dir="${sample.sql.output.dir}/output"
									includes="*.sql"
								/>
							</path>
							<sequential>
								<concat append="true" destfile="${sample-data-sql}">
									<filelist dir="${sample.sql.output.dir}/output" files="@{sql-file-filename}" />
								</concat>
							</sequential>
						</for>
					</then>
					<else>
						<concat append="true" destfile="${sample-data-sql}">
							<filelist dir="${sample.sql.output.dir}" files="sample-${sample.sql.db.type}.sql" />
						</concat>
					</else>
				</if>
			</then>
		</if>
	</target>

	<target name="clean">
		<delete includeemptydirs="true">
			<fileset
				dir="."
				includes="*.csv,*.sql,benchmarks-actual.properties, benchmarks.customer.properties, benchmarks.merge.properties, liferay/**,output/**,temp/**"
			/>
		</delete>
	</target>
</project>