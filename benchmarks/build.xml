<?xml version="1.0"?>

<project basedir="." default="run" name="benchmarks" xmlns:if="ant:if" xmlns:unless="ant:unless">
	<import file="../build-common.xml" />

	<property file="importer.${user.name}.properties" />
	<property file="importer.properties" />
	<property file="benchmarks.properties" />

	<property name="sample-data-sql" value="sample-data-${sample.sql.db.type}.sql" />
	<property name="build-db-file" value="../sql/build.xml" />

	<macrodef name="build-sql">
		<attribute name="dir" />
		<sequential>
			<ant antfile="${build-db-file}" inheritall="false" target="build-db">
				<property name="db.sql.dir" value="@{dir}" />
			</ant>

			<concat append="true" destfile="${basedir}/${sample-data-sql}">
				<filelist dir="@{dir}/tables/" files="tables-${sample.sql.db.type}.sql" />
				<filelist dir="@{dir}/indexes/" files="indexes-${sample.sql.db.type}.sql" />
			</concat>
		</sequential>
	</macrodef>

	<target name="build-sample-sql">
		<gradle-execute dir="../modules/util/portal-tools-sample-sql-builder" task="jar" />

		<unzip
			dest="build"
			overwrite="true"
		>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.portal.tools.sample.sql.builder*.jar"
			/>
		</unzip>

		<path id="sample.sql.builder.classpath">
			<fileset
				dir="build"
				includes="lib/*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.blogs.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.dynamic.data.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.fragment.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.friendly.url.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.journal.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.layout.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.message.boards.*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.portal.tools.sample.sql.builder*.jar"
			/>
			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.subscription.*.jar"
			/>

			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.view.count.*.jar"
			/>

			<fileset
				dir="${sdk.dir}/dist"
				includes="com.liferay.wiki.*.jar"
			/>
			<path refid="project.classpath" />
		</path>

		<property name="sample.sql.properties.file" value="${basedir}/benchmarks.properties" />

		<java
			classname="com.liferay.portal.tools.sample.sql.builder.SampleSQLBuilder"
			classpathref="sample.sql.builder.classpath"
		>
			<sysproperty key="external-properties" value="com/liferay/portal/tools/dependencies/portal-tools.properties" />
			<sysproperty key="sample-sql-properties" value="${sample.sql.properties.file}" />
		</java>

		<delete dir="build" quiet="true" />
	</target>

	<target name="clean">
		<delete includeemptydirs="true">
			<fileset
				dir="."
				includes="*.csv,*.sql,benchmarks-actual.properties,liferay/**,output/**,sample-sql-builder/**,temp/**"
			/>
		</delete>
	</target>

	<target name="exec-sql">
		<sql classpathref="lib.classpath" driver="${jdbc.default.driverClassName}" password="${jdbc.default.password}" src="${basedir}/${sample-data-sql}" url="${jdbc.default.url}" userid="${jdbc.default.username}" />
	</target>

	<target name="merge-create-statements">
		<concat append="true" destfile="${basedir}/${sample-data-sql}">
			<filelist dir="../sql/portal/" files="portal-${sample.sql.db.type}.sql" />
			<filelist dir="../sql/indexes/" files="indexes-${sample.sql.db.type}.sql" />
		</concat>

		<for list="${portal.module.dir.list}" param="module">
			<sequential>
				<build-sql dir="@{module}" />
			</sequential>
		</for>

		<unzip
			dest="${basedir}/sample-sql-builder"
			overwrite="true"
		>
			<patternset>
				<include name="lib/*.jar" />
			</patternset>
			<fileset
				dir="../tools/sdk/dist"
				includes="com.liferay.portal.tools.sample.sql.builder*.jar"
			/>
		</unzip>

		<for param="service-jar-filename">
			<path>
				<fileset
					dir="${basedir}/sample-sql-builder/lib"
					includes="*service*.jar"
				/>
			</path>
			<sequential>
				<unzip
					dest="${basedir}/sample-sql-builder/lib"
					overwrite="true"
					src="@{service-jar-filename}"
				>
					<patternset>
						<include name="**/*.sql" />
					</patternset>
				</unzip>

				<build-sql dir="${basedir}/sample-sql-builder/lib/META-INF/sql" />
			</sequential>
		</for>
	</target>

	<target depends="clean, merge-create-statements, build-sample-sql" name="merge-statements">
		<concat append="true" destfile="${basedir}/${sample-data-sql}" if:true="${sample.sql.output.merge}">
			<filelist dir="${sample.sql.output.dir}" files="sample-${sample.sql.db.type}.sql" />
		</concat>
		<if>
			<equals arg1="${sample.sql.output.merge}" arg2="false" />
			<then>
				<for param="sql-file-filename">
					<path>
						<fileset
							dir="${sample.sql.output.dir}/output"
							includes="*.sql"
						/>
					</path>
					<sequential>
						<concat append="true" destfile="${basedir}/${sample-data-sql}">
							<filelist dir="${sample.sql.output.dir}/output" files="@{sql-file-filename}" />
						</concat>
					</sequential>
				</for>
			</then>
		</if>
	</target>
</project>